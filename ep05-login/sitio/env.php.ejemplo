<?php
declare(strict_types=1);

/*
 * env.php — la configuración secreta de TU sistema. Este archivo es el EJEMPLO: cópialo como «env.php», cambia cada
 * valor entre <…> y el dominio, y súbelo AL LADO de las carpetas app/, config/ y cron/ (⛔ nunca dentro de
 * public_html). Permisos 600 en el administrador de archivos: solo tu cuenta lo puede leer.
 *
 * ⛔ No lo subas a GitHub ni lo compartas: trae la contraseña de tu base y tus claves.
 * Si dejas un valor sin cambiar, el sistema se niega a arrancar («Servicio no disponible») y anota en el log de PHP
 * qué clave falta o qué clave no tiene la forma esperada (nunca su valor).
 *
 * Las dos claves de 64 caracteres salen de herramientas/generar-claves.html: ábrelo en tu computadora, con doble
 * clic, y copia cada una. Son al azar y distintas cada vez que lo abres.
 */

return [
    'APP_ENV'           => 'production',          // 'production' en tu hosting; 'local' solo en tu computadora
    'APP_DEBUG'         => false,                 // en producción no cuenta: el sistema lo apaga
    'APP_URL'           => 'https://TU-DOMINIO',  // tu dominio, en minúsculas y sin diagonal al final

    'DB_HOST'           => '127.0.0.1',           // en un hosting compartido, casi siempre 127.0.0.1 o localhost
    'DB_NAME'           => '<el nombre de tu base, como sale en el panel>',
    'DB_USER'           => '<el usuario de tu base>',
    'DB_PASS'           => '<la contraseña de ese usuario>',

    'ACCESO_HMAC_CLAVE' => '<la primera clave de generar-claves.html>',

    // SOLO para crear la primera cuenta en https://TU-DOMINIO/instalar. En cuanto la creas, /instalar se apaga solo
    // y esta línea ya no hace nada: la puedes borrar.
    'INSTALACION_CLAVE' => '<la segunda clave de generar-claves.html>',
];
